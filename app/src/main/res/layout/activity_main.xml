<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Barra de Status da IA e Sensores -->
    <LinearLayout
        android:id="@+id/panelAiStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/txtAiEngine"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="IA CENA: Analisando..."
            android:textColor="#00E676"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtFilterStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FILTRO: NENHUM"
            android:textColor="#FFD600"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Botões Rápidos de Configurações Técnicas -->
    <LinearLayout
        android:id="@+id/panelQuickSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#40000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/panelAiStatus">

        <Button
            android:id="@+id/btnTogglePhotoFormat"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:text="FOTO: JPG"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnToggleCodec"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:text="CODEC: H.264"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnToggleAudioBitrate"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:text="ÁUDIO: 192K"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnCycleND"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:text="ND: OFF"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Barra de Controle Manual (EV / Exposição) -->
    <SeekBar
        android:id="@+id/exposureBar"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:max="100"
        android:progress="50"
        app:layout_constraintBottom_toTopOf="@id/btnCapture"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Botão Foto -->
    <Button
        android:id="@+id/btnCapture"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="28dp"
        android:backgroundTint="#FFFFFF"
        android:text="DISPARO"
        android:textColor="#000000"
        android:textSize="9sp"
        app:cornerRadius="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Botão Vídeo -->
    <Button
        android:id="@+id/btnRecord"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:backgroundTint="#D50000"
        android:text="REC"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        app:cornerRadius="30dp"
        app:layout_constraintBottom_toBottomOf="@id/btnCapture"
        app:layout_constraintEnd_toStartOf="@id/btnCapture"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnCapture" />

    <!-- Botão Alternar Traseira / Frontal -->
    <Button
        android:id="@+id/btnSwitch"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:backgroundTint="#37474F"
        android:text="GIRAR"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        app:cornerRadius="30dp"
        app:layout_constraintBottom_toBottomOf="@id/btnCapture"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnCapture"
        app:layout_constraintTop_toTopOf="@id/btnCapture" />

</androidx.constraintlayout.widget.ConstraintLayout>
