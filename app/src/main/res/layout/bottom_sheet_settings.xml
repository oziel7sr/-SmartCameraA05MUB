<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#16161D"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Indicador de Arrasto -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#55FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Painel de Controle Profissional"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="420dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- SETOR 1: RECURSOS DA CÂMERA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="RECURSOS DA CÂMERA &amp; IA"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchEis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Estabilização Eletrônica (EIS)"
                android:textColor="#EEEEEE" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchHdrAi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="HDR Inteligente com IA"
                android:textColor="#EEEEEE" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchNoiseReduction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Supressão de Ruído de Alta Qualidade"
                android:textColor="#EEEEEE" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Temporizador de Disparo:"
                android:textColor="#B0BEC5"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rgTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbTimerOff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Desligado"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rbTimer3s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="3s"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rbTimer10s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="10s"
                    android:textColor="#FFFFFF" />
            </RadioGroup>

            <!-- SETOR 2: FOTOGRAFIA -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="#22FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FOTOGRAFIA &amp; COMPRESSÃO"
                android:textColor="#29B6F6"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Formato de Imagem:"
                android:textColor="#B0BEC5"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rgPhotoFormat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbJpg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="JPG"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rbPng"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="PNG (Lossless)"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rbRaw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="RAW / DNG"
                    android:textColor="#FFFFFF" />
            </RadioGroup>

            <!-- SETOR 3: VÍDEO -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="#22FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VÍDEO &amp; ENCODERS"
                android:textColor="#FF5252"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Contêiner e Codec de Hardware:"
                android:textColor="#B0BEC5"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rgVideoCodec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbH264"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="H.264 (MP4)"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rbH265"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="H.265 / HEVC (MKV)"
                    android:textColor="#FFFFFF" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Bitrate do Áudio AAC:"
                android:textColor="#B0BEC5"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rgAudioBitrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb128k"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="128 kbps"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rb192k"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:checked="true"
                    android:text="192 kbps"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rb320k"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="320 kbps"
                    android:textColor="#FFFFFF" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Taxa de Quadros (Vídeo):"
                android:textColor="#B0BEC5"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rgFps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbFps30"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="30 FPS (NTSC)"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rbFps50"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="50 FPS (PAL)"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rbFps60"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="60 FPS (HFR)"
                    android:textColor="#FFFFFF" />
            </RadioGroup>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
